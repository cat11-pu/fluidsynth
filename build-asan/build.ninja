build doc/examples/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /home/cat/gsb/uid3976/build-asan/doc/examples && /usr/bin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build doc/examples/test: phony doc/examples/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build doc/examples/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/cat/gsb/uid3976/build-asan/doc/examples && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build doc/examples/edit_cache: phony doc/examples/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build doc/examples/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/cat/gsb/uid3976/build-asan/doc/examples && /usr/bin/cmake --regenerate-during-build -S/home/cat/gsb/uid3976 -B/home/cat/gsb/uid3976/build-asan
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build doc/examples/rebuild_cache: phony doc/examples/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build doc/examples/list_install_components: phony


#############################################
# Utility command for install

build doc/examples/CMakeFiles/install.util: CUSTOM_COMMAND doc/examples/all
  COMMAND = cd /home/cat/gsb/uid3976/build-asan/doc/examples && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build doc/examples/install: phony doc/examples/CMakeFiles/install.util


#############################################
# Utility command for install/local

build doc/examples/CMakeFiles/install/local.util: CUSTOM_COMMAND doc/examples/all
  COMMAND = cd /home/cat/gsb/uid3976/build-asan/doc/examples && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build doc/examples/install/local: phony doc/examples/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build doc/examples/CMakeFiles/install/strip.util: CUSTOM_COMMAND doc/examples/all
  COMMAND = cd /home/cat/gsb/uid3976/build-asan/doc/examples && /usr/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build doc/examples/install/strip: phony doc/examples/CMakeFiles/install/strip.util

